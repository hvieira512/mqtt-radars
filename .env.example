# MQTT Broker Connection
MQTT_SERVER=your_mqtt_server_ip
MQTT_PORT=1883
# leave empty if no auth required
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=php-radar-router-local
MQTT_TOPIC=radar/+/+

# Redis
REDIS_URL=tcp://127.0.0.1:6379

# Forward consumer
FORWARD_SLEEP_MS=50
FORWARD_CONNECT_TIMEOUT_MS=750
FORWARD_TIMEOUT_MS=5000
FORWARD_MAX_ATTEMPTS=3
FORWARD_BATCH_SIZE=100
FORWARD_DISABLE_BATCH=false
FORWARD_DRY_RUN=false
# Pin one consumer to a specific license, e.g. 1001
FORWARD_LICENSE=
# Skip dedicated consumers for these licenses, e.g. 1001,2103
FORWARD_EXCLUDE_LICENSES=

# CRM URL for tenant URL lookup
CRM_URL=https://crm.hitcare.net/api/get.url.php
CRM_CACHE_TTL=3600

# Hobacare API (sleep reports)
APP_ID=your_app_id
SECRET=your_app_secret
LOGIN_URL=https://qinglanst.com/prod-api/login
BASE_URL=https://qinglanst.com/prod-api/thirdparty/v2/
HOBACARE_USERNAME=your_hobacare_username
HOBACARE_PASSWORD=your_hobacare_password

# Database (for simulator UID lookup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=radar
DB_USERNAME=radar_user
DB_PASSWORD=your_db_password

# Tenant app ingest path (relative to each tenant's web root)
INGEST_PATH=modulos/radares/_ajax/radar-data-ingest.php
