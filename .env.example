# Ligacao ao broker MQTT
MQTT_SERVER=127.0.0.1
MQTT_PORT=1883
# Deixar vazio se o broker nao exigir autenticacao
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=radar/+/+
# Estavel e sem PID: duas instancias com o mesmo id expulsam-se em ciclo
MQTT_CLIENT_ID=php-radar-router
# Lista separada por virgulas; vazio aceita todas
ALLOWED_LICENSES=

# Redis
REDIS_URL=tcp://127.0.0.1:6379

# Resolucao do endereco da plataforma por licenca
CRM_URL=https://crm.hitcare.net/api/get.url.php
CRM_CACHE_TTL=3600
# Sobrepoe-se ao CRM e dirige todas as licencas ao mesmo destino; so desenvolvimento
TEST_TARGET_URL=

# Consumidor de entrega
FORWARD_SLEEP_MS=100
FORWARD_CONNECT_TIMEOUT_MS=5000
FORWARD_TIMEOUT_MS=60000
FORWARD_MAX_ATTEMPTS=3
FORWARD_BATCH_SIZE=100
FORWARD_DRY_RUN=false
# Fixa o consumidor a uma licenca, equivalente a --license
FORWARD_LICENSE=
# Para consumidores genericos, salta licencas com unidade dedicada
FORWARD_EXCLUDE_LICENSES=

# Espera entre tentativas do mesmo lote, a dobrar a cada uma
FORWARD_RETRY_BASE_MS=1000
FORWARD_RETRY_MAX_MS=30000
# Teto da fila de falhas: guarda as ultimas N como amostra. 0 desliga o teto
FORWARD_FAILED_CAP=5000
# Desliga a verificacao de certificado. Excecao por instalacao, com data e
# motivo; nunca por omissao — o que segue e telemetria de saude
FORWARD_TLS_INSECURE=false
