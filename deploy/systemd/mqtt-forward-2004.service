[Unit]
Description=MQTT Forward Consumer for license 2004
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mqtt-radars
ExecStart=/usr/bin/php forward-consumer.php --license=2004
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
