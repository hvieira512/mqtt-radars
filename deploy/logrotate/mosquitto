# O `log_type all` escreve cerca de 3 GB por dia. Na máquina antiga não havia
# rotação nenhuma, e o log chegou a 3,4 GB num dia e meio.
#
# O mosquitto reabre o ficheiro com SIGHUP, que é o que o `reload` envia. Sem
# isso continuaria a escrever no inode antigo, já apagado, e o log parava de
# crescer sem ninguém notar.
/var/log/mosquitto/mosquitto.log {
    daily
    rotate 7
    maxsize 500M
    compress
    delaycompress
    missingok
    notifempty
    create 0600 mosquitto mosquitto
    postrotate
        systemctl reload mosquitto > /dev/null 2>&1 || true
    endscript
}
